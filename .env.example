# Image tag
APP_VERSION=latest
DOCKER_PLATFORM=linux/amd64
PYTHON_IMAGE=python:3.12.3-slim
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_VERSION=16
POSTGRES_IMAGE=postgres:16
REDIS_VERSION=7
REDIS_IMAGE=redis:7

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,你的服务器IP,你的域名

# Published ports on the server
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=5173
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND=127.0.0.1
REDIS_PORT=6379

# Backend runtime
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=1800
RUN_MIGRATIONS=1
RUN_SEED_BASE=0
FILE_UPLOAD_TEMP_DIR=/app/media/tmp_uploads

# PostgreSQL
POSTGRES_DB=srf
POSTGRES_USER=srf_user
POSTGRES_PASSWORD=change-me-to-a-strong-db-password

# AI model connection. Profiles live in backend/config/ai_models.json.
# Usually switching this value and the matching key is enough.
AI_PROFILE=openai
# Optional profile overrides; leave blank to use backend/config/ai_models.json.
AI_PROVIDER=
AI_API_STYLE=
AI_MODEL_NAME=
AI_API_KEY_ENV=
AI_BASE_URL_ENV=
AI_PROMPT_VERSION=resume-screening-v1
AI_DECISION_VERSION=decision-v1
AI_PROFILE_VERSION=profile-v1
AI_PARSER_VERSION=pypdf-v1
OPENAI_API_KEY=
OPENAI_BASE_URL=

# DeepSeek V4 key (set AI_PROFILE=deepseek to use this profile)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
